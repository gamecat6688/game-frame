config_version=5

[application]
config/name="Ember Expedition"
config/description="Godot + Go authority + excel2pb prototype"
run/main_scene="res://ui/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=720
window/size/viewport_height=1120
window/size/window_width_override=540
window/size/window_height_override=840
window/stretch/mode="canvas_items"

[internationalization]
locale/translations=PackedStringArray("res://localization/ui.zh_CN.po", "res://localization/ui.zh_TW.po", "res://localization/ui.en.po")
locale/fallback="en"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.09, 0.105, 1)

[game]
backend="local"
server_url="ws://127.0.0.1:18080/ws"
development_token="prototype-local"
locale="zh_CN"
